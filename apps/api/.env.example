# apps/api environment (SPEC §8.4). Copy to .env; secrets never committed.
# Dev default matches the root compose.yaml container (sharq-db). If you had
# to change POSTGRES_PORT in the root .env (e.g. a native postgres owns 5432),
# match the port here.
DATABASE_URL=postgresql://sharq:sharq@localhost:5433/sharq
# Optional (SPEC 10.7 defaults shown; validated fail-fast at boot):
# PORT=3000
# NODE_ENV=development
# LOG_LEVEL=info
# RATE_LIMIT_AUTH_PER_MIN=10
# RATE_LIMIT_WRITES_PER_MIN=120
# RATE_LIMIT_READS_PER_MIN=300
