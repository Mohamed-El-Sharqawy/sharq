{
  "name": "@sharq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts | pino-pretty",
    "build": "bun build --target=bun src/index.ts --outdir=dist",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "seed": "bun run src/db/seed.ts",
    "line-count": "node ../../tooling/check-line-count.mjs"
  },
  "dependencies": {
    "@elysiajs/openapi": "catalog:",
    "@sharq/locales": "workspace:*",
    "@sharq/schemas": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:",
    "elysia-rate-limit": "catalog:",
    "pino": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@sharq/eslint-config": "workspace:*",
    "@sharq/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:"
  }
}
