{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "inputs": [
        "src/**/*.{ts,tsx}",
        "app/**/*.{ts,tsx}",
        "tests/**/*.ts",
        "e2e/**/*.{ts,tsx}",
        "eslint.config.js",
        "react-router.config.ts",
        "vite.config.ts",
        "vitest.config.ts",
        "playwright.config.ts",
        "drizzle.config.ts",
        "../../packages/eslint-config/index.js",
        "../../packages/eslint-config/package.json"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**/*.{ts,tsx}",
        "app/**/*.{ts,tsx}",
        "tests/**/*.ts",
        "e2e/**/*.{ts,tsx}",
        "tsconfig.json",
        "react-router.config.ts",
        "vite.config.ts",
        "vitest.config.ts",
        "playwright.config.ts",
        "drizzle.config.ts",
        "../../packages/tsconfig/*.json"
      ]
    },
    "test": {},
    "test:integration": {
      "inputs": ["tests/integration/**", "drizzle/**", "src/db/**"]
    },
    "line-count": {
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "../../tooling/check-line-count.mjs",
        "../../.linecount-exemptions.json"
      ]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
