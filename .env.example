# Local dev Postgres — root compose.yaml (SPEC §8.4). Copy to `.env` to override.
# DEV ONLY: throwaway local credentials, never production values.
# apps/api/.env (Phase 1) derives DATABASE_URL from these:
#   postgres://POSTGRES_USER:POSTGRES_PASSWORD@localhost:POSTGRES_PORT/POSTGRES_DB
# NOTE: if a native Postgres already owns host port 5432 (netstat -ano | findstr 5432),
# set POSTGRES_PORT to a free port (e.g. 5433) and match it in apps/api/.env.
POSTGRES_USER=sharq
POSTGRES_PASSWORD=sharq
POSTGRES_DB=sharq
POSTGRES_PORT=5433
