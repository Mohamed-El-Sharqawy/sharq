{
  "name": "@sharq/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles/*": "./src/styles/*",
    "./components/*": "./src/components/*",
    "./lib/*": "./src/lib/*",
    "./hooks/*": "./src/hooks/*"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "line-count": "node ../../tooling/check-line-count.mjs"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@sharq/locales": "workspace:*",
    "@sharq/schemas": "workspace:*",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@sharq/eslint-config": "workspace:*",
    "@sharq/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
