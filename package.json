{
  "name": "sharq",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "line-count": "turbo run line-count",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @sharq/api exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @sharq/api exec bun run src/db/migrate.ts",
    "db:studio": "pnpm --filter @sharq/api exec drizzle-kit studio",
    "db:up": "docker compose up -d",
    "db:stop": "docker compose stop",
    "db:reset": "docker compose down -v"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "catalog:"
  }
}
